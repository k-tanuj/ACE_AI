# ==============================================================================
# ACE_AI Module 5: Event Verification & Organizer Credibility Engine
# Environment Configuration Template
# ==============================================================================

# Application Environment (development, staging, production)
APP_ENV=development
LOG_LEVEL=INFO
SECRET_KEY=replace-with-a-secure-random-32-byte-hex-string-in-production

# Database Configuration (PostgreSQL with pgvector extension)
# For local SQLite testing/demo: sqlite:///./ace_ai_trust.db
DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/ace_ai

# Redis Cache URL
REDIS_URL=redis://localhost:6379/0

# Embedding Model Configuration
EMBEDDING_MODEL_NAME=all-MiniLM-L6-v2
EMBEDDING_DIM=384

# Optional LLM API Keys (for enhanced semantic moderation)
GEMINI_API_KEY=
OPENAI_API_KEY=
